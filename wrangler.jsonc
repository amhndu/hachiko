{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hachiko",
	"main": "src/server/index.ts",
	"compatibility_date": "2026-10-05",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/agents/*"]
	},
	"ai": { "binding": "AI" },
	"browser": { "binding": "BROWSER" },
	"durable_objects": {
		"bindings": [{ "name": "Hachiko", "class_name": "Hachiko" }]
	},
	"workflows": [
		{ "name": "hachiko-check", "binding": "CHECK_WORKFLOW", "class_name": "CheckWorkflow" }
	],
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hachiko"] }],
	"vars": {
		"ORCHESTRATOR_MODEL": "@cf/zai-org/glm-4.7-flash",
		"COMPILER_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
	},
	"observability": { "enabled": true },
	// Local runs without Cloudflare credentials: every binding except the
	// models, which have no local emulation. The manual-spec path (testSpec,
	// createFromSpec) and scheduled checks work; chat, compile and heal throw.
	// Everything here runs on the Workers Free plan.
	// CLOUDFLARE_ENV=offline pnpm dev
	"env": {
		"offline": {
			"browser": { "binding": "BROWSER", "remote": false },
			"durable_objects": {
				"bindings": [{ "name": "Hachiko", "class_name": "Hachiko" }]
			},
			"workflows": [
				{ "name": "hachiko-check", "binding": "CHECK_WORKFLOW", "class_name": "CheckWorkflow" }
			],
			"vars": {
				"ORCHESTRATOR_MODEL": "@cf/zai-org/glm-4.7-flash",
				"COMPILER_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
			}
		}
	}
}
